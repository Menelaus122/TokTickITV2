// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 2 enums
// ---------------------------------------------------------------------------

// BR-07 — the Requester must choose one of these explicitly; there is no default.
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// BR-02 — a new Ticket starts at NEW, and NEW is the only status Lab 2 allows.
// The enum exists so the Lab 4 lifecycle is an additive migration rather than a
// column type change (specification.md D-08).
enum TicketStatus {
  NEW
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

// Issue 3 (Lab 1) — IT request categories.
// Lab 2 adds isActive so a category can be retired without breaking the tickets
// that already point at it (specification.md D-09).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Lab 2 — the specific service, application, device, or platform a ticket is
// about (Email, Campus Wi-Fi, VPN, ...).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Development Requester — BR-03
// A temporary Lab 2 testing identity, NOT authentication. It deliberately has
// no password, role, or session column. Lab 3 grows this model rather than
// replacing it (BR-46).
// ---------------------------------------------------------------------------
model RequesterUser {
  id         Int      @id @default(autoincrement())
  fullName   String
  email      String   @unique
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tickets Ticket[]

  // The selector queries active requesters on every application start.
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Ticket
// ---------------------------------------------------------------------------
model Ticket {
  id Int @id @default(autoincrement())

  // BR-01 — generated by the backend and unique. The unique constraint is the
  // last line of defence behind the generator's retry.
  ticketNumber String @unique

  requesterId     Int
  categoryId      Int
  relatedSystemId Int

  summary     String @db.VarChar(120)  // BR-26
  description String @db.VarChar(4000) // BR-27

  requestedPriority RequestedPriority
  currentStatus     TicketStatus      @default(NEW)

  createdAt DateTime @default(now()) // BR-05 — this is the Ticket Date
  updatedAt DateTime @updatedAt      // BR-08 — drives "Last Updated"

  requester     RequesterUser @relation(fields: [requesterId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  attachments   Attachment[]

  // Serves every My Tickets query: the owner filter plus the default sort.
  @@index([requesterId, createdAt])
}

// ---------------------------------------------------------------------------
// Attachment
// ---------------------------------------------------------------------------
model Attachment {
  id       Int @id @default(autoincrement())
  ticketId Int

  // BR-35 — the original name is metadata only and is never used as a path.
  originalFilename String
  storedFilename   String @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  // BR-38 / specification.md 7.4 — soft removal is one nullable timestamp, not
  // a boolean plus a date. "removedAt IS NULL" is the definition of active, so
  // the two facts cannot drift apart.
  removedAt     DateTime?
  removalReason String?   @db.VarChar(200) // BR-39

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Attachments are always fetched per Ticket.
  @@index([ticketId])
}
