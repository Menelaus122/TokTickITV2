// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Lab 3 BR-17 — every user holds exactly one of these.
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Renamed from Lab 2's RequestedPriority (Lab 3 D-05), because IT Priority now
// uses the same four values. The rename is hand-written SQL in the migration:
// Prisma has no rename detection and would otherwise drop the type (D-21).
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Lab 3 BR-31. Lab 2 shipped only NEW so that this widening would be an
// additive migration rather than a column type change (Lab 2 D-08).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

// Issue 3 (Lab 1) — IT request categories.
// Lab 2 adds isActive so a category can be retired without breaking the tickets
// that already point at it (Lab 2 specification.md D-09).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Lab 2 — the specific service, application, device, or platform a ticket is
// about (Email, Campus Wi-Fi, VPN, ...).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// User — Lab 3
// Lab 2's RequesterUser, renamed and grown rather than replaced, so every
// existing id and every Ticket.requesterId survives the migration (BR-60).
// ---------------------------------------------------------------------------
model User {
  id         Int     @id @default(autoincrement())
  fullName   String
  // BR-45 — unique, stored lowercased.
  email      String  @unique
  // Kept from Lab 2, read-only in Lab 3 (D-16).
  department String?
  isActive   Boolean @default(true)

  // BR-06 — a bcrypt hash, never the password. Nullable because the migration
  // cannot compute a hash for existing rows; the seed fills it (BR-61, D-22),
  // and a null hash can never authenticate (BR-66).
  passwordHash       String?
  role               Role      @default(REQUESTER)
  // BR-46 — a new account must change its password at first login.
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedTickets Ticket[]        @relation("TicketRequester")
  ownedTickets     Ticket[]        @relation("TicketOwner")
  sessions         Session[]
  publicComments   PublicComment[]
  internalNotes    InternalNote[]

  // The assignable-owner list and the Administrator's role filter (§7.3).
  @@index([role, isActive])
}

// ---------------------------------------------------------------------------
// Session — Lab 3 D-01
// A server-side row, so logout is a real invalidation (BR-12). The cookie holds
// the raw token; only its SHA-256 is stored, so a database dump holds no usable
// session (BR-10, D-02).
// ---------------------------------------------------------------------------
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.Char(64)
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Deleting a user's sessions on password change and deactivation.
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Ticket
// ---------------------------------------------------------------------------
model Ticket {
  id Int @id @default(autoincrement())

  // Lab 2 BR-01 — generated by the backend and unique. The unique constraint is
  // the last line of defence behind the generator's retry.
  ticketNumber String @unique

  requesterId     Int
  // Lab 3 BR-24 — at most one owner, and a ticket arrives unassigned.
  ownerId         Int?
  categoryId      Int
  relatedSystemId Int

  summary     String @db.VarChar(120) // Lab 2 BR-26
  description String @db.VarChar(4000) // Lab 2 BR-27

  // Lab 3 BR-27 — the Requester's value, immutable for every role.
  requestedPriority Priority
  // Lab 3 BR-28 — copied from requestedPriority at creation, then IT Staff's.
  // Stored separately so re-prioritising never hides what was asked for (D-06).
  itPriority        Priority
  currentStatus     TicketStatus @default(NEW)
  // Lab 3 BR-29 — the Requester's "Problem Appears Resolved" signal.
  requesterResolvedAt DateTime?

  createdAt DateTime @default(now()) // Lab 2 BR-05 — this is the Ticket Date
  updatedAt DateTime @updatedAt // Lab 2 BR-08 — drives "Last Updated"

  requester     User          @relation("TicketRequester", fields: [requesterId], references: [id])
  // Restrict: an owner can never be deleted out from under a ticket. Users are
  // deactivated, never deleted (BR-50).
  owner         User?         @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]

  // Serves every My Tickets query: the owner filter plus the default sort.
  @@index([requesterId, createdAt])
  // The queue's ownership filter.
  @@index([ownerId])
  // The queue's default order and its status filter (BR-55).
  @@index([currentStatus, itPriority, createdAt])
}

// ---------------------------------------------------------------------------
// Attachment
// ---------------------------------------------------------------------------
model Attachment {
  id       Int @id @default(autoincrement())
  ticketId Int

  // Lab 2 BR-35 — the original name is metadata only and is never used as a path.
  originalFilename String
  storedFilename   String @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  // Lab 2 BR-38 — soft removal is one nullable timestamp, not a boolean plus a
  // date. "removedAt IS NULL" is the definition of active, so the two facts
  // cannot drift apart.
  removedAt     DateTime?
  removalReason String?   @db.VarChar(200) // Lab 2 BR-39

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Attachments are always fetched per Ticket.
  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Public Comments and Internal Notes — Lab 3
// Two tables, not one with a visibility flag: a forgotten WHERE clause can then
// never leak a note into a Requester's thread (BR-39, D-04). Both are
// append-only in Lab 3 (BR-42).
// ---------------------------------------------------------------------------
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(2000) // BR-41
  createdAt DateTime @default(now()) // BR-40 — backend-generated

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  // One thread read per ticket, in order.
  @@index([ticketId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(2000) // BR-41
  createdAt DateTime @default(now()) // BR-40 — backend-generated

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}
