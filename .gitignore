client/src/**/*.js
client/tests/**/*.js

# Playwright traces and failure screenshots, for Lab 2's and Lab 3's suites
# alike (playwright.config.ts outputDir); the checklist screenshots under
# artifacts/lab-0*/screenshots/ are kept.
artifacts/lab-02/playwright-output/
playwright-report/
test-results/

# submission working documents (the PDF is the deliverable, not its source .docx)
docs/lab-02/*.docx
docs/lab-03/*.docx
~$*.docx
